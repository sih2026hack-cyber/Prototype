# Preview server
PORT=8787

# X API. Keep this server-side and never put it in frontend JavaScript.
X_BEARER_TOKEN=
X_QUERY=(flooding OR waterlogging OR "heavy rain") (Chennai OR Tamil Nadu) lang:en -is:retweet

# Supabase REST credentials. Use the service-role key only on the backend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Production Python pipeline
SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
ARGUS_HASH_SALT=replace-with-a-long-random-value
MODERATOR_ENABLED=false
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io

# Comment moderator (ai-moderator-plugin/): NVIDIA Nemotron on Nebius Token Factory while its
# credits last, then MiniMax (above). Leave NEBIUS_API_KEY empty to use MiniMax only.
NEBIUS_API_KEY=
# Optional: your remaining Nebius credit in US$. ARGUS estimates spend from token counts and
# stops calling Nemotron when it reaches this. Without it, ARGUS switches only when Nebius
# refuses a request for billing reasons.
NEBIUS_CREDIT_USD=
# Optional: list prices used for that estimate (US$ per million tokens).
# NEMOTRON_PRICE_IN=1.00
# NEMOTRON_PRICE_OUT=3.00
# Optional: enables GET /api/plugin/queue and POST /api/plugin/resolve (header x-moderator-admin).
ARGUS_MODERATOR_SECRET=

# Argus Lens (lens/, the /lens page and the extension's image checks): Meta Model API
# (Muse Wonder + SAM 3.1). Paid, with no cheaper backup model: when the credits are used up,
# Lens answers "Couldn't check" instead of spending more.
MODEL_API_KEY=
# Optional: your remaining Meta credit in US$. Lens estimates spend and stops when it reaches this.
META_CREDIT_USD=

# Browser extension (extension/). Optional locally; on a public deployment it is how the
# extension gets past the dashboard password. Put the same value in the extension's settings.
ARGUS_EXTENSION_KEY=
